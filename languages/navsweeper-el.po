#: includes/class-navsweeper-plugin.php:99
msgid "Please select at least one menu item to edit."
msgstr "Παρακαλώ επιλέξτε τουλάχιστον ένα στοιχείο μενού για επεξεργασία."

#: includes/class-navsweeper-plugin.php:100 views/admin-view.php:57
msgid "Please select at least one field to update."
msgstr "Παρακαλώ επιλέξτε τουλάχιστον ένα πεδίο για ενημέρωση."

#: includes/class-navsweeper-plugin.php:101
msgid "Please provide values for all selected fields."
msgstr "Παρακαλώ συμπληρώστε τιμές για όλα τα επιλεγμένα πεδία."

#. translators: %d: number of items
#: includes/class-navsweeper-plugin.php:103
#, php-format
msgid "Are you sure you want to update %d item(s)?"
msgstr "Είστε σίγουροι ότι θέλετε να ενημερώσετε %d στοιχεία;"

#: includes/class-navsweeper-plugin.php:104
msgid "Are you sure you want to delete these items?"
msgstr "Είστε σίγουροι ότι θέλετε να διαγράψετε αυτά τα στοιχεία;"

#: includes/class-navsweeper-plugin.php:105
msgid "Please select at least one menu item to move."
msgstr "Παρακαλώ επιλέξτε τουλάχιστον ένα στοιχείο μενού για μετακίνηση."

#: includes/class-navsweeper-plugin.php:106 views/admin-view.php:55
msgid "Please select a destination menu."

{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "wporg-mcp-server": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@automattic/mcp-wordpress-remote@latest"
      ],
      "environment": {
        "WP_API_URL": "https://wordpress.org/wp-json/mcp/wporg",
        "WP_API_USERNAME": "${WP_API_USERNAME}",
        "WP_API_PASSWORD": "${WP_API_PASSWORD}"
      },
      "enabled": true
    }
  }
}